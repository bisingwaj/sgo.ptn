// ============================================================
// PTN-RDC · Schéma Prisma — Domaine Authentification & Habilitations
//
// Source de vérité institutionnelle : Manuel d'Exécution du Projet (MEP)
// du 23 juin 2025, validé par le Gouvernement de la RDC, la Banque mondiale
// et l'AFD.
//
// Principe directeur : un compte n'est pas « un utilisateur avec un rôle ».
// C'est une personne (User), rattachée à une organisation (Organisation),
// exerçant un sous-rôle (Subrole) sur un périmètre, pendant une durée
// déterminée. Ce triplet est porté par Assignment.
// ============================================================

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
  // Imports sans extension : NestJS compile en CommonJS et le seed
  // s'exécute via ts-node, qui ne réécrit pas `.js` vers `.ts`.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ÉNUMÉRATIONS
// ============================================================

/// Les 8 profils utilisateurs — présentation UGPTN § 15.2.
/// Aligné sur src/lib/profiles.ts côté frontend.
enum ProfileKey {
  UGP
  MDA
  PARTENAIRE
  BAILLEUR
  SOUMISSIONNAIRE
  SBP
  AUDITEUR
  GOUVERNANCE
}

/// Les 4 familles du sélecteur de connexion.
enum ProfileFamily {
  UGP_GOUV
  BAILLEURS
  BENEFICIAIRES
  CONTROLE
}

/// Cycle de vie d'un compte. Aucune suppression physique : la piste
/// d'audit doit permettre de répondre à « qui avait accès à quoi, quand »
/// plusieurs années après les faits.
enum UserStatus {
  /// Créé par un admin, mot de passe temporaire non encore consommé
  INVITE
  /// Mot de passe défini et onboarding complété
  ACTIF
  /// Accès suspendu temporairement (décision administrative)
  SUSPENDU
  /// Mot de passe temporaire expiré sans activation
  EXPIRE
  /// Archivé — conservé pour l'audit, ne peut plus se connecter
  ARCHIVE
}

enum OrganisationType {
  UGP
  MINISTERE
  AGENCE
  UNIVERSITE
  OSC
  FEDERATION
  ENTREPRISE
  CABINET_AUDIT
  BAILLEUR
  HUB
  STARTUP
  EESU
  AUTRE
}

enum AssignmentStatus {
  ACTIVE
  SUSPENDED
  /// Dépassement de validUntil (missions d'audit bornées)
  EXPIRED
  REVOKED
}

/// Langues supportées — MEP, communications publiques.
enum Language {
  FR
  EN
  LN
  SW
  TS
  KK
}

enum ComponentCode {
  C1
  C2
  C3
  C4
  C5
}

// ============================================================
// RÉFÉRENTIEL MEP
// Données identiques dans tous les environnements, production comprise.
// Alimenté par le seed en mode idempotent (upsert).
// ============================================================

/// Composantes du projet — MEP Tableau 2 § 2.2.4. Total = 510 M USD.
/// Servir ces montants depuis la base est la parade structurelle à la
/// dérive constatée dans les écrans qui les réécrivaient en dur.
model Component {
  code           ComponentCode @id
  label          String
  shortLabel     String
  /// Montants en millions USD
  totalUsdM      Decimal       @db.Decimal(10, 2)
  idaUsdM        Decimal       @db.Decimal(10, 2)
  afdUsdM        Decimal       @db.Decimal(10, 2)
  privateUsdM    Decimal       @db.Decimal(10, 2)
  /// Note de réconciliation lorsque MEP et PAD divergent
  reconciliation String?

  assignments    Assignment[]
  ptbaActivities PtbaActivity[]

  @@map("components")
}

/// 26 provinces de la RDC. `isPriorityCpf` marque les 10 provinces
/// prioritaires du Cadre de Partenariat-Pays.
model Province {
  code          String  @id
  label         String
  isPriorityCpf Boolean @default(false)

  organisations  Organisation[]
  assignments    Assignment[]
  ptbaActivities PtbaActivity[]
  tdrs           Tdr[]

  @@map("provinces")
}

// ============================================================
// ORGANISATIONS
// ============================================================

model Organisation {
  id       String           @id @default(uuid()) @db.Uuid
  /// Sigle officiel — MPTN, ARPTC, ONIP… (glossaire présentation UGPTN § 13.1)
  code     String           @unique
  name     String
  fullName String
  type     OrganisationType

  provinceCode String?
  province     Province? @relation(fields: [provinceCode], references: [code])

  /// KYC — partenaires institutionnels et soumissionnaires
  /// 1 = déclaratif · 2 = vérifié · 3 = signataires habilités
  rccm     String?
  nif      String?
  kycLevel Int     @default(1)

  email String?
  phone String?

  /// Marque les organisations du référentiel MEP (non supprimables)
  isReference Boolean @default(false)
  isActive    Boolean @default(true)

  assignments Assignment[]
  /// TDR rédigés par cette organisation
  authoredTdrs    Tdr[] @relation("TdrAuthorOrganisation")
  /// TDR conduits au bénéfice de cette organisation
  beneficiaryTdrs Tdr[] @relation("TdrBeneficiaryOrganisation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("organisations")
}

// ============================================================
// SOUS-RÔLES & PERMISSIONS
// ============================================================

/// Sous-rôles officiels — 21 pour l'UGP (présentation UGPTN § 6.1), plus ceux des
/// 7 autres profils. Les contraintes institutionnelles (unicité,
/// séparation des tâches, sensibilité) sont portées ici pour que les
/// garde-fous du formulaire de création soient dirigés par la donnée.
model Subrole {
  id      String     @id @default(uuid()) @db.Uuid
  /// Identifiant stable — UGP_COORDONNATEUR, BAILLEUR_TTL_BM…
  code    String     @unique
  label   String
  profile ProfileKey

  /// Un seul titulaire actif à la fois : Coordonnateur, RAF,
  /// Auditeur Interne, RPM. Une réattribution suspend le titulaire.
  isUnique Boolean @default(false)

  /// Habilitation sensible : octroi soumis à justification écrite et
  /// validation du Coordonnateur. Concerne au premier chef le
  /// Spécialiste VBG/EAS, qui ouvre le canal confidentiel EAS/HS.
  isSensitive Boolean @default(false)

  /// Séparation des tâches — codes de sous-rôles incompatibles.
  /// Ex. RAF / Comptable / Caissier ; Auditeur Interne / tout opérationnel.
  incompatibleWith String[] @default([])

  /// Rattachement à une composante obligatoire (RC1, RC2, RC3)
  requiresComponent Boolean @default(false)
  /// Mission bornée obligatoire (auditeurs externes, TPM)
  requiresMission   Boolean @default(false)

  displayOrder Int @default(0)

  permissions SubrolePermission[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profile])
  @@map("subroles")
}

/// Permissions granulaires. Avec 21 sous-rôles UGP, un contrôle par
/// profil ne suffit pas : les interdits du MEP (un bailleur ne rédige
/// jamais de TDR, un auditeur n'écrit jamais) s'expriment ici.
model Permission {
  /// Format `domaine:action` — ano:decide, easHs:read, tdr:author
  code     String  @id
  label    String
  /// passation · fiduciaire · sauvegardes · mgp · pilotage · admin
  category String
  /// Permission d'écriture : refusée d'office aux profils lecture seule
  isWrite  Boolean @default(false)
  /// Permission sensible : tracée individuellement dans le journal d'audit
  isSensitive Boolean @default(false)

  subroles    SubrolePermission[]
  assignments AssignmentPermission[]

  @@index([category])
  @@map("permissions")
}

/// Permissions attachées par défaut à un sous-rôle.
model SubrolePermission {
  subroleId      String @db.Uuid
  permissionCode String

  subrole    Subrole    @relation(fields: [subroleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([subroleId, permissionCode])
  @@map("subrole_permissions")
}

// ============================================================
// UTILISATEURS
// ============================================================

model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique

  /// Null tant que le compte n'a pas été activé
  passwordHash String?

  firstName String
  lastName  String
  phone     String?
  preferredLanguage Language @default(FR)

  status UserStatus @default(INVITE)

  // --- Mot de passe temporaire (mode d'activation retenu) ---
  /// L'admin ne connaît jamais le mot de passe définitif
  mustChangePassword    Boolean   @default(true)
  tempPasswordExpiresAt DateTime?

  // --- Engagements signés par l'utilisateur lui-même ---
  // Un administrateur ne peut pas les signer à sa place : la déclaration
  // de conflit d'intérêts engage la personne (MEP § 5.2.8).
  codeOfConductSignedAt DateTime?
  coiDeclaredAt         DateTime?
  dataPrivacyAckAt      DateTime?
  onboardingCompletedAt DateTime?

  // --- Sécurité de connexion ---
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // --- Traçabilité de la création ---
  createdById  String? @db.Uuid
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")
  authoredTdrs Tdr[]   @relation("TdrAuthor")

  assignments   Assignment[]   @relation("AssignmentUser")
  grantedAssignments Assignment[] @relation("AssignmentGrantedBy")
  approvedAssignments Assignment[] @relation("AssignmentApprovedBy")
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([status])
  @@map("users")
}

// ============================================================
// AFFECTATIONS — le cœur du modèle d'habilitation
// ============================================================

/// Une affectation lie une personne à une organisation, pour un profil
/// et un sous-rôle donnés, sur un périmètre et pendant une durée.
///
/// Le multi-affectation est assumé : un cadre UGP peut aussi siéger au
/// CTP, un point focal MDA peut être membre de commission. Créer deux
/// comptes distincts pour la même personne brouillerait la piste d'audit.
model Assignment {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  organisationId String       @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  profile   ProfileKey
  subroleId String     @db.Uuid
  subrole   Subrole    @relation(fields: [subroleId], references: [id])

  /// Affectation chargée par défaut à la connexion
  isPrimary Boolean @default(false)

  // --- Périmètre ---
  componentCode ComponentCode?
  component     Component?     @relation(fields: [componentCode], references: [code])
  provinceCode  String?
  province      Province?      @relation(fields: [provinceCode], references: [code])

  // --- Bornage temporel ---
  /// Référence de mission — ex. AUD-EXT-2026-T1. Un auditeur externe
  /// conservant son accès après la fin de son mandat est une
  /// non-conformité que tout contrôleur relèvera.
  missionRef String?
  validFrom  DateTime  @default(now())
  validUntil DateTime?

  status AssignmentStatus @default(ACTIVE)

  // --- Habilitation sensible ---
  justification String?
  approvedById  String?   @db.Uuid
  approvedBy    User?     @relation("AssignmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?

  // --- Traçabilité de l'octroi ---
  grantedById String? @db.Uuid
  grantedBy   User?   @relation("AssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  revokedAt    DateTime?
  revokeReason String?

  /// Ajustements par rapport aux permissions par défaut du sous-rôle
  permissions AssignmentPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([organisationId])
  @@index([profile, subroleId])
  @@map("assignments")
}

/// Écart explicite aux permissions par défaut du sous-rôle.
/// `granted = false` retire une permission, `true` en ajoute une.
model AssignmentPermission {
  assignmentId   String  @db.Uuid
  permissionCode String
  granted        Boolean @default(true)
  reason         String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([assignmentId, permissionCode])
  @@map("assignment_permissions")
}

// ============================================================
// SESSIONS
// ============================================================

/// Jetons de rafraîchissement, stockés hachés et à rotation.
/// `replacedById` permet de détecter une réutilisation de jeton révoqué,
/// signal classique de vol de session.
model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  /// Affectation active durant cette session (multi-affectation)
  activeAssignmentId String? @db.Uuid

  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// ============================================================
// PISTE D'AUDIT
// ============================================================

/// Journal en ajout seul, chaîné cryptographiquement.
///
/// Chaque entrée porte le hachage de la précédente : toute suppression ou
/// modification a posteriori rompt la chaîne et devient détectable. C'est
/// l'exigence qui distingue une table de logs d'une piste d'audit
/// opposable devant la Cour des Comptes, l'IGF ou un auditeur BM.
model AuditLog {
  id       String @id @default(uuid()) @db.Uuid
  sequence BigInt @default(autoincrement())

  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Dénormalisé : survit à l'archivage du compte
  actorEmail String?

  /// user.create · assignment.grant · auth.login · easHs.read…
  action     String
  entityType String?
  entityId   String?

  /// Détail de l'événement. Ne doit jamais contenir de secret ni de
  /// donnée nominative issue du canal EAS/HS.
  payload Json?

  ipAddress String?
  userAgent String?

  /// Chaînage
  previousHash String?
  hash         String

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// PLANIFICATION — PTBA
//
// Le Plan de Travail et Budget Annuel est le rattachement obligatoire
// de tout TDR : une activité sans ligne PTBA n'a pas d'enveloppe, donc
// pas de marché possible. Arrêté annuellement et validé par le COPIL.
// ============================================================

enum PtbaStatus {
  /// En préparation par l'UGP
  BROUILLON
  /// Validé par le COPIL, opposable
  VALIDE
  /// Exercice clos
  CLOS
}

model PtbaYear {
  id     String     @id @default(uuid()) @db.Uuid
  year   Int        @unique
  label  String
  status PtbaStatus @default(BROUILLON)

  validatedAt   DateTime?
  validatedById String?   @db.Uuid

  activities PtbaActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ptba_years")
}

/// Objectif de l'activite, distinct de celui d'un TDR : l'activite dit ce
/// qu'elle doit atteindre, le marche dit ce qu'il execute pour y concourir.
model PtbaActivityObjective {
  id         String       @id @default(uuid()) @db.Uuid
  activityId String       @db.Uuid
  activity   PtbaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  title      String
  /// Comment on constatera l'atteinte
  criteria   String?
  position   Int          @default(0)

  @@index([activityId])
  @@map("ptba_activity_objectives")
}

/// Livrable attendu de l'activite. Reserve dans laquelle les TDR puisent :
/// l'un commande le local, l'autre les equipements.
model PtbaActivityDeliverable {
  id         String       @id @default(uuid()) @db.Uuid
  activityId String       @db.Uuid
  activity   PtbaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  title      String
  format     String?
  /// Delai relatif au demarrage — J+15, S+4, M+6
  deadline   String?
  position   Int          @default(0)

  @@index([activityId])
  @@map("ptba_activity_deliverables")
}

/// Indicateur de resultat propre a l'activite. C'est le seul des cinq qui
/// remonte : il alimente le cadre de resultats de la composante.
model PtbaActivityIndicator {
  id         String       @id @default(uuid()) @db.Uuid
  activityId String       @db.Uuid
  activity   PtbaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label      String
  /// Unite ou methode de mesure
  measure    String?
  target     String?
  position   Int          @default(0)

  @@index([activityId])
  @@map("ptba_activity_indicators")
}

/// Risque propre a l'activite, avec son attenuation. Distinct des risques
/// d'execution attaches au type de marche, qui restent au referentiel.
model PtbaActivityRisk {
  id          String       @id @default(uuid()) @db.Uuid
  activityId  String       @db.Uuid
  activity    PtbaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label       String
  description String?
  mitigation  String?
  level       EsCategory?
  position    Int          @default(0)

  @@index([activityId])
  @@map("ptba_activity_risks")
}

/// Norme ou disposition propre a l'activite — ICAO 9303 pour l'identite,
/// ISO 27001 pour un centre de supervision. Les clauses CONTRACTUELLES, qui
/// suivent la forme du marche et non son objet, restent attachees au type
/// de TDR dans la bibliotheque versionnee.
model PtbaActivityClause {
  id         String       @id @default(uuid()) @db.Uuid
  activityId String       @db.Uuid
  activity   PtbaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label      String
  text       String?      @db.Text
  position   Int          @default(0)

  @@index([activityId])
  @@map("ptba_activity_clauses")
}

model PtbaActivity {
  id         String   @id @default(uuid()) @db.Uuid
  ptbaYearId String   @db.Uuid
  ptbaYear   PtbaYear @relation(fields: [ptbaYearId], references: [id], onDelete: Cascade)

  /// Code d'activité — A2.3.1
  code  String
  title String

  componentCode ComponentCode
  component     Component     @relation(fields: [componentCode], references: [code])
  /// Sous-composante MEP — 2.3
  subComponent String?

  /// Enveloppe et sa ventilation, en USD
  envelopeUsd Decimal  @db.Decimal(14, 2)
  idaUsd      Decimal? @db.Decimal(14, 2)
  afdUsd      Decimal? @db.Decimal(14, 2)

  provinceCode String?
  province     Province? @relation(fields: [provinceCode], references: [code])

  isActive Boolean @default(true)

  /// Ce que l'activite porte en propre — saisi avec elle, au plan.
  ///
  /// Ces elements ne rejoignent pas les bibliotheques versionnees du
  /// referentiel : celles-ci decrivent la FORME d'un marche et evoluent
  /// lentement, tandis que ceux-ci decrivent l'OBJET d'une ligne du plan et
  /// suivent le cycle de l'exercice. Ils naissent avec l'activite, se figent
  /// quand l'exercice est valide, et disparaissent avec elle.
  ///
  /// Le TDR y puisera : une activite porte plusieurs marches, et chacun ne
  /// reprend que ce qui le concerne. Jamais d'heritage automatique — un
  /// marche de peinture ne porte pas l'objectif « doter le pays d'un SOC ».
  objectives   PtbaActivityObjective[]
  deliverables PtbaActivityDeliverable[]
  indicators   PtbaActivityIndicator[]
  risks        PtbaActivityRisk[]
  clauses      PtbaActivityClause[]

  tdrs Tdr[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ptbaYearId, code])
  @@index([componentCode])
  @@map("ptba_activities")
}

// ============================================================
// RÉFÉRENTIEL DE PASSATION
// Règlements de Passation des Marchés BM pour Emprunteurs IPF,
// édition de février 2025, et PPSD du PTN-RDC.
// ============================================================

enum ProcurementCategory {
  TRAVAUX
  FOURNITURES
  SERVICES_NON_CONSULTANTS
  SERVICES_CONSULTANTS
}

enum ReviewType {
  /// Revue préalable du bailleur
  PRIOR
  /// Revue postérieure, sur échantillon
  POST
}

/// Origines de rédaction d'un TDR — présentation UGPTN § 15.4.
enum TdrOrigin {
  UGP
  PARTENAIRE
  /// Consultation et ANO uniquement : ne rédige jamais
  BAILLEUR
  SBP
}

model ProcurementMethod {
  code        String              @id
  label       String
  category    ProcurementCategory
  description String?
  displayOrder Int                @default(0)
  isActive    Boolean             @default(true)

  /// Méthode d'exception : gré à gré, source unique, accord-cadre.
  /// Elle ne se déduit jamais d'un montant — elle se justifie. L'exclure
  /// de la résolution automatique évite qu'un marché bascule en gré à gré
  /// pour la seule raison qu'aucun autre seuil ne correspondait.
  isException Boolean             @default(false)

  thresholds ProcurementThreshold[]
  tdrTypes   TdrType[]
  tdrs       Tdr[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("procurement_methods")
}

/// Seuil déterminant la méthode applicable et le type de revue.
/// Bornes en USD ; `maxUsd` nul signifie « sans plafond ».
model ProcurementThreshold {
  id         String              @id @default(uuid()) @db.Uuid
  methodCode String
  method     ProcurementMethod   @relation(fields: [methodCode], references: [code], onDelete: Cascade)
  category   ProcurementCategory

  minUsd Decimal? @db.Decimal(14, 2)
  maxUsd Decimal? @db.Decimal(14, 2)

  reviewType ReviewType
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("procurement_thresholds")
}

/// Les 11 types de TDR — présentation UGPTN § 15.4.
model TdrType {
  code   String @id
  slug   String @unique
  name   String
  /// 1 Passation classique · 2 Activités opérationnelles · 3 Subventions & contrôles
  family      Int
  familyLabel String

  defaultMethodCode String?
  defaultMethod     ProcurementMethod? @relation(fields: [defaultMethodCode], references: [code])

  /// Catégorie de passation dont relève ce type, et donc table de seuils
  /// applicable. Null pour les activités opérationnelles et les subventions,
  /// qui ne relèvent d'aucune méthode de passation classique.
  ///
  /// Portée par le référentiel plutôt que déduite en code : la déduction
  /// existait en double — côté serveur depuis le type, côté écran figée sur
  /// SERVICES_CONSULTANTS — et les deux annonçaient des méthodes différentes
  /// pour un même dossier.
  procurementCategory ProcurementCategory?

  /// Origines autorisées à rédiger ce type
  allowedOrigins TdrOrigin[]
  /// Nombre d'étapes du parcours de rédaction
  stepCount Int @default(5)

  /// Amorce de contexte pré-remplie, avec substitution {{ptbaCode}} et {{ptbaTitle}}
  contextTemplate String? @db.Text

  /// Convention de dénomination du marché, même substitution que contextTemplate.
  /// La nature du contrat ouvre l'intitulé — c'est l'usage en passation, et
  /// c'est ce qui rend une liste de TDR lisible sans l'ouvrir.
  titleTemplate String?
  /// Un PGES est-il requis pour ce type ?
  requiresPges Boolean @default(false)

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  clauses    ClauseTemplate[]
  indicators IndicatorTemplate[]
  risks      RiskTemplate[]
  tdrs       Tdr[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([family])
  @@map("tdr_types")
}

// ============================================================
// BIBLIOTHÈQUES VERSIONNÉES
//
// Ces textes partent dans des documents contractuels soumis à ANO.
// Une modification ne doit jamais réécrire rétroactivement un TDR déjà
// approuvé : chaque édition crée une nouvelle version, l'ancienne est
// archivée mais conservée. `familyKey` relie les versions entre elles.
// ============================================================

enum TemplateStatus {
  BROUILLON
  PUBLIE
  ARCHIVE
}

enum ClauseCategory {
  /// Réglementaire
  REG
  /// Technique
  TECH
  /// Conformité
  CONF
  /// Sauvegarde environnementale et sociale
  SAFE
  /// Gouvernance
  GOV
}

model ClauseTemplate {
  id String @id @default(uuid()) @db.Uuid

  /// Identifiant stable partagé par toutes les versions d'une même clause
  familyKey String
  version   Int    @default(1)

  /// Null pour une clause transversale, applicable à tous les types
  tdrTypeCode String?
  tdrType     TdrType? @relation(fields: [tdrTypeCode], references: [code])

  category ClauseCategory
  label    String
  text     String         @db.Text

  status        TemplateStatus @default(BROUILLON)
  effectiveFrom DateTime?
  supersededAt  DateTime?

  createdById String? @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([familyKey, version])
  @@index([tdrTypeCode, status])
  @@index([category])
  @@map("clause_templates")
}

model IndicatorTemplate {
  id String @id @default(uuid()) @db.Uuid

  familyKey String
  version   Int    @default(1)

  tdrTypeCode String?
  tdrType     TdrType? @relation(fields: [tdrTypeCode], references: [code])

  label String
  /// Type de mesure — ratio, délai, score, pourcentage
  measure String
  /// Cible MEP ou standard PTN-RDC
  target String

  status        TemplateStatus @default(BROUILLON)
  effectiveFrom DateTime?
  supersededAt  DateTime?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([familyKey, version])
  @@index([tdrTypeCode, status])
  @@map("indicator_templates")
}

enum RiskLevel {
  FAIBLE
  MODERE
  SUBSTANTIEL
  ELEVE
}

model RiskTemplate {
  id String @id @default(uuid()) @db.Uuid

  familyKey String
  version   Int    @default(1)

  tdrTypeCode String?
  tdrType     TdrType? @relation(fields: [tdrTypeCode], references: [code])

  label       String
  description String    @db.Text
  mitigation  String    @db.Text
  level       RiskLevel

  status        TemplateStatus @default(BROUILLON)
  effectiveFrom DateTime?
  supersededAt  DateTime?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([familyKey, version])
  @@index([tdrTypeCode, status])
  @@map("risk_templates")
}

// ============================================================
// LE DOCUMENT TDR
//
// Aboutissement du module : jusqu'ici les parcours de rédaction
// n'écrivaient nulle part. Le TDR est la pièce contractuelle initiale
// d'un marché — c'est lui qui part au premier ANO du bailleur.
// ============================================================

enum TdrStatus {
  /// En cours de rédaction par son auteur
  BROUILLON
  /// Transmis à l'UGP
  SOUMIS_UGP
  /// En arbitrage : alignement PTBA, priorisation, validation technique
  REVUE_UGP
  /// Renvoyé à l'auteur pour correction
  RETOURNE
  /// Validé par l'UGP, prêt pour soumission au bailleur
  VALIDE_UGP
  ANO_EN_COURS
  ANO_OBTENU
  ANO_REFUSE
  ARCHIVE
}

/// Niveaux de risque environnemental et social — Cadre BM.
enum EsCategory {
  FAIBLE
  MODERE
  SUBSTANTIEL
  ELEVE
}

model Tdr {
  id        String @id @default(uuid()) @db.Uuid
  /// Référence lisible — PTN-2026-019
  reference String @unique

  /// Rattachement au plan. Obligatoire à la soumission : une activité
  /// sans ligne PTBA n'a pas d'enveloppe, donc pas de marché possible.
  ptbaActivityId String?       @db.Uuid
  ptbaActivity   PtbaActivity? @relation(fields: [ptbaActivityId], references: [id])

  tdrTypeCode String
  tdrType     TdrType @relation(fields: [tdrTypeCode], references: [code])

  /// Origine de rédaction. Déduite de la session, jamais déclarée par
  /// l'auteur : un bailleur ne rédige jamais de TDR (présentation UGPTN § 15.4).
  origin TdrOrigin

  authorId       String       @db.Uuid
  author         User         @relation("TdrAuthor", fields: [authorId], references: [id])
  /// Organisation qui rédige le dossier
  organisationId String       @db.Uuid
  organisation   Organisation @relation("TdrAuthorOrganisation", fields: [organisationId], references: [id])

  /// Maîtrise d'ouvrage bénéficiaire — l'entité pour laquelle l'activité
  /// est conduite, distincte de celle qui rédige. Un TDR porté par l'UGPTN
  /// au bénéfice d'une agence sectorielle n'avait jusqu'ici aucun endroit
  /// où consigner cette agence, ce qui conduisait l'assistance
  /// rédactionnelle à la deviner.
  beneficiaryOrganisationId String?       @db.Uuid
  beneficiaryOrganisation   Organisation? @relation("TdrBeneficiaryOrganisation", fields: [beneficiaryOrganisationId], references: [id])

  title  String
  status TdrStatus @default(BROUILLON)

  // --- Cadrage ---
  context       String? @db.Text
  justification String? @db.Text
  beneficiaries String? @db.Text

  /// Champs auxquels l'assistant a contribue.
  ///
  /// Remplace le geste de reprise que l'ancien parcours exigeait : l'agent
  /// ecrivant directement, il faut une autre trace de ce qui vient d'une
  /// machine. Elle subsiste jusqu'a la transmission et reste lisible en
  /// revue UGP — un relecteur doit pouvoir savoir ou porter son attention.
  ///
  /// Elle dit qu'il a CONTRIBUE, non que le texte serait de lui : l'auteur
  /// retouche ensuite, et la marque reste vraie.
  aiAssistedFields String[] @default([])

  /// Ce que l'on constatera, avec son horizon — distinct des objectifs, qui
  /// disent l'intention. Le wizard partenaire les séparait et renvoyait au
  /// cadre de résultats du projet ; la fusion des deux parcours avait retenu
  /// la version du MDA, qui ne les distinguait pas.
  expectedResults String? @db.Text

  /// Modalités valant pour l'ensemble des livrables — forme de remise et
  /// fréquence des points d'avancement. Contractuelles, elles ne se règlent
  /// pas livrable par livrable : le wizard partenaire les portait déjà,
  /// celui du MDA les avait omises.
  deliverableFormat String?
  reportingRhythm   String?

  // --- Méthodologie ---
  approach    String? @db.Text
  methodology String? @db.Text
  constraints String? @db.Text

  // --- Calendrier et expertise ---
  startDate      DateTime?
  durationMonths Int?
  /// Volume d'effort en jours-homme. Pour un marché de consultants, c'est
  /// l'unité de facturation : la durée calendaire ne s'y substitue pas.
  effortDays     Int?
  provinceCode   String?
  province       Province? @relation(fields: [provinceCode], references: [code])
  expertise      String?   @db.Text
  keyProfiles    String[]  @default([])

  // --- Budget, ventilé par source ---
  budgetTotalUsd Decimal? @db.Decimal(14, 2)
  budgetIdaUsd   Decimal? @db.Decimal(14, 2)
  budgetAfdUsd   Decimal? @db.Decimal(14, 2)
  budgetGovUsd   Decimal? @db.Decimal(14, 2)

  /// Méthode et type de revue figés à la soumission, depuis les seuils en
  /// vigueur à cette date. Les recalculer plus tard donnerait un résultat
  /// différent si les seuils ont changé entre-temps.
  procurementMethodCode String?
  procurementMethod     ProcurementMethod? @relation(fields: [procurementMethodCode], references: [code])
  reviewType            ReviewType?

  // --- Sauvegardes ---
  esCategory EsCategory?
  esRisks    String[]    @default([])

  // --- Engagements de l'auteur ---
  consentMepAt  DateTime?
  consentRgpdAt DateTime?

  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewNote  String?   @db.Text

  objectives   TdrObjective[]
  deliverables TdrDeliverable[]
  clauses      TdrClause[]
  indicators   TdrIndicator[]
  risks        TdrRisk[]
  versions     TdrVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([authorId])
  @@index([organisationId])
  @@map("tdrs")
}

model TdrObjective {
  id       String @id @default(uuid()) @db.Uuid
  tdrId    String @db.Uuid
  tdr      Tdr    @relation(fields: [tdrId], references: [id], onDelete: Cascade)
  title    String
  criteria String @db.Text
  position Int    @default(0)

  @@map("tdr_objectives")
}

model TdrDeliverable {
  id       String  @id @default(uuid()) @db.Uuid
  tdrId    String  @db.Uuid
  tdr      Tdr     @relation(fields: [tdrId], references: [id], onDelete: Cascade)
  title    String
  format   String?
  deadline String?
  position Int     @default(0)

  @@map("tdr_deliverables")
}

/// Clause retenue dans un TDR.
///
/// Le texte est COPIÉ depuis la bibliothèque, jamais référencé : modifier
/// la bibliothèque ne doit pas réécrire un TDR déjà soumis à ANO.
/// `sourceFamilyKey` et `sourceVersion` gardent la trace de l'origine,
/// à titre documentaire.
model TdrClause {
  id              String         @id @default(uuid()) @db.Uuid
  tdrId           String         @db.Uuid
  tdr             Tdr            @relation(fields: [tdrId], references: [id], onDelete: Cascade)
  sourceFamilyKey String?
  sourceVersion   Int?
  category        ClauseCategory
  label           String
  text            String         @db.Text
  position        Int            @default(0)

  @@map("tdr_clauses")
}

model TdrIndicator {
  id              String  @id @default(uuid()) @db.Uuid
  tdrId           String  @db.Uuid
  tdr             Tdr     @relation(fields: [tdrId], references: [id], onDelete: Cascade)
  sourceFamilyKey String?
  sourceVersion   Int?
  label           String
  measure         String
  target          String
  position        Int     @default(0)

  @@map("tdr_indicators")
}

model TdrRisk {
  id              String    @id @default(uuid()) @db.Uuid
  tdrId           String    @db.Uuid
  tdr             Tdr       @relation(fields: [tdrId], references: [id], onDelete: Cascade)
  sourceFamilyKey String?
  sourceVersion   Int?
  label           String
  description     String    @db.Text
  mitigation      String    @db.Text
  level           RiskLevel
  position        Int       @default(0)

  @@map("tdr_risks")
}

/// Instantané immuable pris à chaque soumission. C'est lui qui permet de
/// reconstituer le document exactement tel qu'il a été transmis, des
/// années après — exigence d'auditabilité.
model TdrVersion {
  id            String   @id @default(uuid()) @db.Uuid
  tdrId         String   @db.Uuid
  tdr           Tdr      @relation(fields: [tdrId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  submittedById String?  @db.Uuid
  createdAt     DateTime @default(now())

  @@unique([tdrId, version])
  @@map("tdr_versions")
}

/// Compteur de références par exercice, pour produire PTN-2026-019.
model TdrSequence {
  year    Int @id
  lastSeq Int @default(0)

  @@map("tdr_sequences")
}
