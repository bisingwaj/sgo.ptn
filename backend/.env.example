# ============================================================
# PTN-RDC · Backend — variables d'environnement
# Copier ce fichier en `.env` et adapter si nécessaire.
# Le `.env` n'est jamais commité.
# ============================================================

# --- Base de données ---
# Port 5432 : instance PostgreSQL locale standard.
# Avec docker-compose, remplacer par 5433 (port hôte du service `postgres`).
DATABASE_URL="postgresql://ptn:ptn_dev_password@localhost:5432/ptn_rdc?schema=public"

# --- JWT ---
# En développement, ces valeurs peuvent rester telles quelles : les deux
# développeurs partagent alors les mêmes secrets, donc les mêmes tokens.
# En production, générer avec : openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-a-remplacer-en-production"
JWT_REFRESH_SECRET="dev-refresh-secret-a-remplacer-en-production"
JWT_ACCESS_EXPIRATION="15m"

# --- Durée de session ---
# Le jeton de rafraîchissement porte l'inactivité : il vaut 30 minutes et
# n'est renouvelé que lorsque la personne agit. Sans activité, la session
# s'éteint d'elle-même côté serveur — un minuteur seulement côté navigateur
# serait contournable.
# Granularité effective : JWT_ACCESS_EXPIRATION (le renouvellement n'a lieu
# qu'à l'expiration du jeton d'accès).
SESSION_IDLE_TIMEOUT="30m"

# --- Amorçage du premier administrateur ---
# Créé par le seed. C'est le seul compte qui n'est pas créé par un admin
# (problème de l'œuf et de la poule). Sous-rôle UGP « IT ».
BOOTSTRAP_ADMIN_EMAIL="admin@ptn-rdc.gov.cd"
BOOTSTRAP_ADMIN_PASSWORD="Admin@PTN2026"

# --- Sécurité ---
# Coût bcrypt : 12 en production, 10 en développement (seed plus rapide)
BCRYPT_ROUNDS=10
# Durée de validité d'un mot de passe temporaire créé par l'admin (heures)
TEMP_PASSWORD_TTL_HOURS=72
# Verrouillage après N échecs de connexion
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Serveur ---
# BACKENDPORT prime sur PORT si les deux sont définies : elle permet de lever
# un conflit de port local sans toucher au reste de la configuration.
# Si vous changez de port, pensez à aligner NEXT_PUBLIC_API_URL côté frontend.
PORT=3001
# BACKENDPORT=3333
NODE_ENV=development
# Origine autorisée pour CORS (frontend Next.js)
CORS_ORIGIN="http://localhost:3000"

# --- Assistance rédactionnelle (OpenRouter) ---
# L'appel part du serveur : la clé ne circule jamais côté navigateur.
# Sans clé, les endpoints d'assistance répondent 503 et le parcours reste
# entièrement utilisable à la main.
OPENROUTER_API_KEY=""
# Modèle par défaut ; ajustable sans redéploiement.
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
