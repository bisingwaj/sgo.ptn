# PTN-RDC · Variables de production
#
# Ce fichier est un MODÈLE. Le vrai s'appelle .env.prod, vit sur le serveur
# en droits 600, et n'entre jamais dans git ni dans une image Docker.
#
#   cp .env.prod.example .env && chmod 600 .env
# ---------- Base de données ----------
POSTGRES_USER=ptn
# Engendrer, ne pas inventer :  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=ptn_rdc

# ---------- Jetons ----------
# Deux secrets DISTINCTS. Le même des deux côtés permettrait de présenter
# un jeton de rafraîchissement comme un jeton d'accès.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
SESSION_IDLE_TIMEOUT=30m

# ---------- Amorçage ----------
# Le premier administrateur. Changer ce mot de passe à la première
# connexion : il aura transité par ce fichier.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- Politique de comptes ----------
BCRYPT_ROUNDS=12
TEMP_PASSWORD_TTL_HOURS=48
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_MINUTES=15

# ---------- Réseau ----------
NODE_ENV=production
# Port publié sur la boucle locale. 4100 est pris par le call-center.
API_BIND_PORT=4200
WEB_BIND_PORT=4300
BACKENDPORT=4200
# Les origines autorisées, séparées par des virgules. SANS barre oblique
# finale : la comparaison est stricte.
# Domaines exacts et familles de sous-domaines, séparés par des virgules.
# Le joker ne couvre qu'un niveau : https://*.vercel.app accepte
# https://sgo-ptn.vercel.app, jamais https://vercel.app.attaquant.cd
CORS_ORIGIN=https://*.vercel.app

# ---------- Assistance ----------
# La clé ne doit apparaître nulle part ailleurs. Elle vaut de l'argent et
# ouvre un compte : la révoquer si elle a transité par un canal partagé.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ---------- Construction de l'interface ----------
# Inscrites dans le code à la compilation, donc lues au `docker compose
# build` et non au démarrage.
PUBLIC_API_URL=https://ugpt-api.urgences-rdc.com/api
PUBLIC_SESSION_IDLE_MINUTES=30

# ---------- Publication des images ----------
GITHUB_REPOSITORY=votre-org/sgo.ptn
TAG=latest
